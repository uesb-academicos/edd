{
  "name": "UESB - Estrutura de Dados - Java 21",
  "image": "mcr.microsoft.com/devcontainers/java:21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "Desktop Java Swing",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "java.project.sourcePaths": [
          "java/Árvore Genealógica/src",
          "java/Árvore Genealógica/tests"
        ],
        "java.project.outputPath": "java/Árvore Genealógica/out"
      }
    }
  },
  "postCreateCommand": "bash \"java/Árvore Genealógica/scripts/validar.sh\"",
  "remoteUser": "vscode"
}
